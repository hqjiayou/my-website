# 部署用环境变量范本。复制为仓库根 .env 后填写。不要把真实口令写回这个文件。
# Compose 用仓库根 .env 做 ${} 替换。容器不会读到整份文件。
# 口令请用 openssl rand -hex 24 这类十六进制，避免 $、@、:、空格把 URL 或 Compose 替换截断。
# .env 已被仓库 .gitignore 忽略。

# ---------- PostgreSQL（镜像与 Java DB_* / POSTGRES_*）----------
# 库名。Java 的 JDBC URL 由 compose 拼成 jdbc:postgresql://postgres:5432/<此值>
POSTGRES_DB=my_website_dev
# Java 与 postgres 镜像共用的超级用户。不要把检索账号填到这里。
POSTGRES_USER=mywebsite
# 强密码占位。必须换成新值。
POSTGRES_PASSWORD=CHANGE_ME

# ---------- Redis（auth 会话 / 限流；site-app 也读 REDIS_*）----------
# compose 会把它传给 redis-server --requirepass，以及 REDIS_PASSWORD / AUTH_REDIS_PASSWORD。
REDIS_PASSWORD=CHANGE_ME

# ---------- Java ↔ Python 内部令牌（两边必须是同一个非空值）----------
# 生成：openssl rand -hex 32
AGENT_INTERNAL_SERVICE_TOKEN=CHANGE_ME

# ---------- proxy-services 管理口令（admin ↔ CLI 代理进程，两边必须是同一个值）----------
# Compose 对它用 ${...:?} 强制要求：不填 docker compose up 会直接报错。
# admin 侧叫 PROXY_SERVICES_MANAGEMENT_KEY；proxy-services 容器侧注入为 MANAGEMENT_PASSWORD。
# 生成：openssl rand -hex 24
PROXY_SERVICES_MANAGEMENT_KEY=CHANGE_ME

# ---------- 模型入口 api_key 加密口令（admin / agent-app 共用）----------
# 不填时 Compose 与本地 profile 都回退到已知默认值 local-dev-model-entry-secret，
# 等于模型入口的 api_key 只以该默认口令加密。部署必须换成独立随机值；
# 换值后已加密的旧入口要重新保存 api_key 才能解密。
# 生成：openssl rand -hex 24
AI_MODEL_ENTRY_SECRET=CHANGE_ME

# ---------- Python AI（只注入 agent 容器）----------
# 已实测的模型 spec。程序没有默认模型；留空则进程能起，chat 返回 503，providerStatus=BLOCKED。
AI_MODEL=google:gemini-3-flash-preview
# Gemini API key 占位。未填写真实 key 时对话是 503 BLOCKED，不是成功回复。
AI_PROVIDER_API_KEY=CHANGE_ME

# ---------- 检索库（Python RETRIEVAL_DATABASE_URL，由 compose 拼装）----------
# 专用账号和库，不要用 POSTGRES_USER。库和扩展要按 docs/operations/SELF_HOSTING.md 建一次。
# 只建库、不填下面的嵌入模型时，检索保持 BLOCKED，纯问答仍可用。
AGENT_RETRIEVAL_DB=agent_retrieval
AGENT_RETRIEVAL_USER=agent_retrieval
AGENT_RETRIEVAL_PASSWORD=CHANGE_ME
# 可选。例：google:gemini-embedding-001 。留空则检索 BLOCKED。
AI_EMBEDDING_MODEL=
# 必须和向量列一致。gemini-embedding-001 用 768；text-embedding-3-small 常用 1536。
AI_EMBEDDING_DIMENSIONS=1536

# ---------- Auth JWT（只写容器内路径，不写 PEM 内容）----------
# 宿主文件放在 services/website-services/secrets/local/（已 gitignore），compose 只读挂到 /secrets。
# 不要把路径写成 CHANGE_ME，auth 会报 RSA key file not found。
# 生成命令见 docs/operations/SELF_HOSTING.md。私钥需对容器内非 root 用户可读（chmod a+r）。
AUTH_JWT_PRIVATE_KEY_PATH=/secrets/auth-private.pem
AUTH_JWT_PUBLIC_KEY_PATH=/secrets/auth-public.pem
AUTH_JWT_KEY_ID=auth-local-rs256-key-1

# ---------- Agent Portal 构建期变量（改后必须重建 web 镜像）----------
# 正整数 agent ID，只作登录会话缺失时的后备，用于 /api/agent/{agentId}/ai/**。
# 登录页填的是 agent code，不是这个 ID。
# 留空时 Agent Portal 能打开，站点 AI 会提示未配置。
VITE_PORTAL_AGENT_ID=

# ---------- 可选，与现有 application-local.yml 默认一致 ----------
# Caddy 不做 TLS。false 让局域网 HTTP 备援也能带上 Refresh Cookie；Tailscale 的 HTTPS 页面同样接受这个 Cookie。
SECURITY_REFRESH_COOKIE_SECURE=false
# 平台 DDL 只由 admin 执行。auth 的 application-local.yml 把 flyway 写死为 false，不受这里影响。
FLYWAY_ENABLED=true
# site-app 与 admin 共用一个库，默认不要再跑一遍迁移。
AGENT_APP_FLYWAY_ENABLED=false
