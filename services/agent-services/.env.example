# agent-services (Python) — 本地示例；生产请用密钥管理注入

PORT=3001
# UVICORN_WORKERS=1

# 必需。与 Java AGENT_INTERNAL_SERVICE_TOKEN 一致。
# 缺失 → 进程启动失败（安全配置错误，非 Provider BLOCKED）
AGENT_INTERNAL_SERVICE_TOKEN=CHANGE_ME

# 进程回退模型（provider-neutral，无默认模型）。
# Java 模型入口有启用的默认项时，对话用那一条的 spec 和 key，不读这里。
# 两边都没有 → providerStatus=BLOCKED，chat 503（ADR-0004）
# 例：
#   AI_MODEL=openai:gpt-4o-mini
#   AI_MODEL=azure:my-deployment        （凭证走 Azure 原生环境变量）
#   AI_MODEL=anthropic:claude-sonnet-4-5
#   AI_MODEL=google:gemini-3-flash-preview
#     已實測範例。程式沒有預設模型，部署者仍須明示 AI_MODEL。
#     舊別名：AI_MODEL=google-gla:gemini-3-flash-preview
# AI_MODEL=

# OpenAI-compatible 直配（本地模型 / 代理 / Foundry compatible 端点）
# AI_PROVIDER_API_KEY 也可放 Gemini API key。
# 未設定時，同一份 .env 裡的 GEMINI_API_KEY 或 GOOGLE_API_KEY 會用於 Google 嵌入。
# 若設定 AI_PROVIDER_BASE_URL，會傳給對應 Provider（含 Google）。
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_BASE_URL=
# Google 嵌入回退鑰匙：未直配 AI_PROVIDER_API_KEY 時，嵌入模型為 Google 就讀這一把
# （config.py 以 AliasChoices 讀 GEMINI_API_KEY 或 GOOGLE_API_KEY，只讀同一份 .env）。
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=agent-services
# OTEL_DEPLOYMENT_ENVIRONMENT=local

# Java↔Python 契约集成测试专用（生产/日常开发勿设）
# AGENT_CONTRACT_USE_TEST_MODEL=true

# Phase 3：派生检索库（专用 DB 用户，禁止授予 Java 业务表权限）
# 下面三键缺任一：启动日志列出缺的键名；health 的 retrievalBlockedReason 同样列出。
# 索引（写入/删除/重嵌准备）立刻 503 RETRIEVAL_NOT_CONFIGURED，并在 message 里写明缺哪些键。
# 不带 providerStatus，所以不会被收成通用的 EXTERNAL_DEPENDENCY_BLOCKED。
# 问答不读这份清单：库或嵌入失败时检索降级，对话继续。
# RETRIEVAL_DATABASE_URL=postgresql://agent_retrieval:CHANGE_ME@127.0.0.1:5432/agent_retrieval
# AI_EMBEDDING_MODEL=openai:text-embedding-3-small
# AI_EMBEDDING_MODEL=google:gemini-embedding-001
#   舊別名：AI_EMBEDDING_MODEL=google-gla:gemini-embedding-001
# AI_EMBEDDING_DIMENSIONS 必須與向量欄位一致。小于 1 视为未配置。
# text-embedding-3-small 常用 1536；gemini-embedding-001 可設 768。
# 此預設不會因 provider 改寫，Settings 全域預設仍是 1536。
# Google 硬上限 100 条，默认每批 16 条，避免一次打满免费额度的每分钟 token。
# 429/5xx 有限次退避，并尊重 Retry-After 或错误体里的 retryDelay。整批仍失败才按块重试。
# AI_EMBEDDING_DIMENSIONS=1536
# RETRIEVAL_MIN_SCORE 餘弦門檻，預設 0.35。低於此分的向量命中不返回，topK 不湊滿。
# 0 關閉。小於 0、大於 1 或非數字 → 啟動失敗。
# 詞法：代碼型 token 優先（如 XJ-900 整段保留；另收含數字且長度≥2，或字母數字長度≥4），
# 其次原文中的小寫英數詞（長度≥2），再是 CJK 連續段（單字，或長度≥2 的重疊 bigram）。最多 24 個。
# 在嵌入與向量查詢都成功後，只按 site_id 做字面量子串匹配。% _ \ 不當通配符。
# 分數取餘弦與覆蓋率的較大值。詞法命中不受向量最低分門檻影響。
# RETRIEVAL_MIN_SCORE=0.35
# 每次向量查詢在同一事務內設定 hnsw.ef_search。維度超過 2000 時不建 HNSW 索引，搜尋改走掃描。
# RETRIEVAL_HNSW_EF_SEARCH=40
# 融合候選多於 topK 且能解析聊天模型時，截斷前做 listwise 重排。預設開。失敗維持融合原序，不把檢索標成 degraded。
# RETRIEVAL_RERANK_ENABLED=true
# RETRIEVAL_RERANK_TIMEOUT_SECONDS=4
# RETRIEVAL_RERANK_MAX_CANDIDATES=12
# 融合後相對分數裁剪：低於「本批最高分 × 此比例」的命中直接丟棄。預設 0.7，0 關閉。
# RETRIEVAL_SCORE_RATIO_FLOOR=0.7
# rerank 相關性裁門：開啟時 rerank 只保留模型判定相關的候選（被省略者丟棄、不回填）。預設開。
# RETRIEVAL_RERANK_CUTOFF=true
# 同源塊數上限：同一文檔最多幾塊進 topK，防長文檔相鄰塊擠佔其他文檔。預設 2，0 不限制。
# RETRIEVAL_MAX_CHUNKS_PER_SOURCE=2

# Phase 4：Function Tools → Java site-app internal（不经 gateway）
# 缺失 → 不注册业务工具
# BUSINESS_API_BASE_URL=http://127.0.0.1:8082

# Phase 5 / §19–§20：Skills / Todo / MCP（平台能力）
# AGENT_SKILLS_DIR=/app/skills
# AGENT_HARNESS_DIR=/app/harness
# AGENT_DEFAULT_SKILLS=orchestration
# ignore（默认）| reject — 未知 skill id 时是否 400
# AGENT_SKILLS_UNKNOWN_POLICY=ignore
# 注入系统提示的 skill 正文总字符上限（正整数；非法值启动失败）
# AGENT_SKILLS_MAX_INSTRUCTION_CHARS=12000
# AGENT_ENABLE_TODO_TOOLS=true
# 主 agent 的 delegate_task：把自包含子任务交给只能查知识的子 agent。关闭后不注册、提示词不提。
# 子 run 请求上限与超时分开配置。每次委派会计入本轮请求/token 预算。
# AGENT_SUBAGENT_ENABLED=true
# AGENT_SUBAGENT_MAX_PER_RUN=4
# AGENT_SUBAGENT_TIMEOUT_SECONDS=60
# AGENT_SUBAGENT_MAX_REQUESTS=6
# MCP 配置（JSON 数组）。未设置 → mcpStatus=DISABLED，不注册 MCP。
# 字段：name, url, enabled?, headers?, toolPrefix?, initTimeoutSeconds?, transport?(http|sse|stdio)
# stdio：{name, transport:"stdio", command, args?, env?, cwd?}。以本进程权限启动 command，只配置信任的 server。
# env 只传条目里的字符串。MCP SDK 再并上默认可继承变量（非 Windows：HOME/LOGNAME/PATH/SHELL/TERM/USER），不会把父进程环境整份交出去。
# sse 已弃用（MCP 2026-07-28），仍可用，解析时记 warning。
# 深检：GET /internal/v1/mcp/ready（短超时 list tools；失败 503）。/health 仍只报配置态。
# 本地 smoke：uv run --extra dev python scripts/run_mcp_echo.py
# MCP_SERVERS_JSON=[{"name":"echo","url":"http://127.0.0.1:3999/mcp","initTimeoutSeconds":5}]
# 非法 JSON → 进程仍可起，health mcpStatus=INVALID_CONFIG，跳过 MCP 注册
# 已配置但连接失败 → chat/stream 503 errorCode=MCP_UNAVAILABLE（不静默降级）

# §22：运行预算 / 上下文 / 冗余 / 观测（<=0 表示该维度不限）
# 超限 → chat 422 / stream ERROR errorCode=AGENT_BUDGET_EXCEEDED（不返回部分回复）
# AGENT_MAX_REQUESTS=10
# AGENT_MAX_TOOL_CALLS=20
# AGENT_MAX_TOTAL_TOKENS=0
# 對話後抽取長期記憶的總開關（預設開；關閉後不抽取也不注入記憶）
# AGENT_MEMORY_EXTRACTION_ENABLED=true
# 单次工具调用超时（todo / MCP 均生效）→ 模型收到重试提示
# AGENT_TOOL_TIMEOUT_SECONDS=30
# 送模历史的字符预算：从最新往前保留，并保证以 USER 开头
# AGENT_HISTORY_MAX_CHARS=24000
# 主模型 API 错误（429/5xx）时依次尝试；主模型 BLOCKED 时不生效（ADR-0004）
# 凭证走各 Provider 原生环境变量，不复用 AI_PROVIDER_*
# AI_FALLBACK_MODELS=anthropic:claude-sonnet-4-5
# OTel 启用时是否在 span 中记录 prompt / completion / 工具参数正文（含 PII，默认关闭）
# AGENT_OTEL_INCLUDE_CONTENT=false
