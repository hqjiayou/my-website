# website-services local environment example
# Copy values into your local shell, IDE run configuration, or an untracked .env file.

DB_URL=jdbc:postgresql://localhost:5432/my_website_dev
DB_USERNAME=mywebsite
DB_PASSWORD=CHANGE_ME

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

FLYWAY_ENABLED=true
# site-app 与 admin 共用同一库时请勿双开 Flyway；脚本由 admin 统一执行
SITE_APP_FLYWAY_ENABLED=false

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=uploads
MINIO_SECURE=false
