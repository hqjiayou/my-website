# 本地开发环境变量范本 — 仓库跟踪文件，仅供复制后改写；请勿在本文件中写入真实口令、密钥或个人账号。
# 真实配置放在同级 `.env`：该文件已被仓库 `.gitignore` 忽略，不会进入 Git/GitHub。
# 使用方式：cp .env.example .env   再编辑 `.env`（勿提交 `.env`）。
#
# LocalDotenvSupport：从 user.dir 向上查找 `.env`；若在仓库根启动则加载 `services/website-services/.env`。写入系统属性；
# 与 OS 环境变量已存在的同名变量或已有 System Property 不覆盖。
#
# 本地基础设施统一使用既有 local-stack（本仓库不再附带 PostgreSQL / Redis 的 Compose）；应用通过主机端口连接：
#   PostgreSQL   → local-postgres → localhost:5432
#   Redis        → local-redis    → localhost:6379
#   MinIO/AIStor → local-aistor   → localhost:9000（控制台端口以你的 local-stack 为准，常见为 9001）
#
# 若 local-stack 自身使用独立 `.env`，请在其所在目录维护，勿与 website-services/.env 混用。
#
# ---------- PostgreSQL（与 JDBC 占位符对齐）----------
# 下列三项便于与各模块 application-local.yml 中的默认值一致；远程库或非默认端口时用 DB_* / DB_URL 覆盖。
# 仅当远程库或非默认端口时，再取消注释并设置 DB_URL（可选覆盖 DB_USERNAME / DB_PASSWORD）。
POSTGRES_DB=my_website_dev
POSTGRES_USER=mywebsite
POSTGRES_PASSWORD=CHANGE_ME

# DB_URL=jdbc:postgresql://localhost:5432/my_website_dev
# DB_USERNAME=mywebsite
# DB_PASSWORD=CHANGE_ME

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ---------- MinIO / S3 兼容（storage.*） ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=uploads
MINIO_SECURE=false

# ---------- Auth 服务数据库/Redis（可选；未设置时与 Admin 共用 DB_* / REDIS_*）----------
# AUTH_DB_URL=jdbc:postgresql://localhost:5432/my_website_dev
# AUTH_DB_USERNAME=mywebsite
# AUTH_DB_PASSWORD=CHANGE_ME
# AUTH_REDIS_HOST=localhost
# AUTH_REDIS_PORT=6379
# AUTH_REDIS_PASSWORD=CHANGE_ME

# ---------- Auth JWT — RS256（私钥/公钥路径；勿提交真实 PEM 文件）----------
# 生成命令见：services/website-services/scripts/local/README-4G-jwks.md
AUTH_JWT_PRIVATE_KEY_PATH=CHANGE_ME
AUTH_JWT_PUBLIC_KEY_PATH=CHANGE_ME
AUTH_JWT_KEY_ID=auth-local-rs256-key-1

# ---------- Resource Server — JWKS（Admin；未来 Site 登录后复用同一 Auth 端点）----------
AUTH_JWKS_URI=http://localhost:8083/.well-known/jwks.json

SECURITY_REFRESH_COOKIE_SECURE=false

# ---------- Auth App（默认 8083）----------
AUTH_APP_PORT=8083

# ---------- Flyway（可选覆盖） ----------
FLYWAY_ENABLED=true
AGENT_APP_FLYWAY_ENABLED=false

# ---------- Agent（site-app → agent-services；勿把 LLM Provider Key 放进 Java 进程）----------
AGENT_BASE_URL=http://127.0.0.1:3001
AGENT_INTERNAL_SERVICE_TOKEN=CHANGE_ME

# ---------- proxy-services（CLI 代理进程，admin 读状态；口令与 Compose MANAGEMENT_PASSWORD 相同）----------
PROXY_SERVICES_BASE_URL=http://127.0.0.1:8317
PROXY_SERVICES_MANAGEMENT_KEY=
# 本地自设随机值，与 proxy-services 的 MANAGEMENT_PASSWORD 相同；真实值不要提交。
# AGENT_CONNECT_TIMEOUT_MS=2000
# AGENT_READ_TIMEOUT_MS=120000
# AGENT_RETRY_MAX_ATTEMPTS=1

