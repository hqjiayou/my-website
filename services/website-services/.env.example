# 本地开发环境变量范本（勿提交真实的个人口令或生产密钥）。
# 使用方式：复制为本目录下的 `.env`（勿提交仓库）：  cp .env.example .env
#
# Docker Compose 会自动读取同级 `.env`，用于 postgres 服务初始化变量替换。
# Admin / Site / Auth App 应用在启动时通过 LocalDotenvSupport 向上查找 `.env` 并写入系统属性，
# 供下列占位符绑定（与 OS 环境变量同名时不覆盖）。
#
# ---------- PostgreSQL（Compose + JDBC）----------
# 本地请只维护下列三项；Spring 默认 JDBC 用户名/口令/库名与此一致（见各模块 application-local.yml）。
# 仅当远程库或非默认端口时，再取消注释并设置 DB_URL（可选覆盖 DB_USERNAME / DB_PASSWORD）。
POSTGRES_DB=my_website_dev
POSTGRES_USER=mywebsite
POSTGRES_PASSWORD=CHANGE_ME

# DB_URL=jdbc:postgresql://localhost:5432/my_website_dev
# DB_USERNAME=mywebsite
# DB_PASSWORD=CHANGE_ME

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ---------- MinIO / S3 兼容（storage.*） ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=uploads
MINIO_SECURE=false

# ---------- Auth 服务数据库/Redis（可选；未设置时与 Admin 共用 DB_* / REDIS_*）----------
# AUTH_DB_URL=jdbc:postgresql://localhost:5432/my_website_dev
# AUTH_DB_USERNAME=mywebsite
# AUTH_DB_PASSWORD=CHANGE_ME
# AUTH_REDIS_HOST=localhost
# AUTH_REDIS_PORT=6379
# AUTH_REDIS_PASSWORD=CHANGE_ME

# ---------- Admin 认证 — HS256（local；必须在个人 .env 中换成≥32字节随机串）----------
# HS256（当前实现）要求至少 32 个 UTF-8 字节；以下仅为可被替换的占位，非安全随机值：
SECURITY_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG
SECURITY_REFRESH_COOKIE_SECURE=false

# ---------- Auth App（默认 8083；4F 后为完整认证服务） ----------
AUTH_APP_PORT=8083

# ---------- Flyway（可选覆盖） ----------
FLYWAY_ENABLED=true
SITE_APP_FLYWAY_ENABLED=false
