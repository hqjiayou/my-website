{
  "version": 1,
  "hooks": {
    "preToolUse": [{ "command": "node .cursor/hooks/guard.js", "timeout": 10, "failClosed": true }],
    "beforeShellExecution": [{ "command": "node .cursor/hooks/guard.js", "timeout": 10, "failClosed": true }],
    "stop": [{ "command": "node .cursor/hooks/continue.js", "timeout": 10, "loop_limit": 30 }]
  }
}
